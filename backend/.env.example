# ── Required in Phase 2 (Docker / local dev) ──────────────────────────────────
DATABASE_URL=postgresql+asyncpg://risklens:risklens@localhost:5432/risklens
REDIS_URL=redis://localhost:6379/0

# ── Required in Phase 4 (Authentication) ─────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# ── Required in Phase 6 (Market data ingestion) ───────────────────────────────
# Free key from https://finnhub.io
FINNHUB_API_KEY=

# ── Required in Phase 15 (AI analyst) ────────────────────────────────────────
# From https://console.anthropic.com
ANTHROPIC_API_KEY=
