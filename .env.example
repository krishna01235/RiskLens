# RiskLens — Root Environment Variables
#
# Copy this file to .env, fill in the secrets, then run:
#   docker compose up
#
# This file documents every variable the Compose stack reads.
# The backend/.env.example covers the same variables in a backend-only context.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=risklens
POSTGRES_PASSWORD=risklens
POSTGRES_DB=risklens

# ── Connection URLs (used by FastAPI app and workers) ─────────────────────────
# Inside the Docker network — service names are the hostnames.
DATABASE_URL=postgresql+asyncpg://risklens:risklens@postgres:5432/risklens
REDIS_URL=redis://redis:6379/0

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-real-secret

# ── External APIs (required from their respective phases) ─────────────────────
# Phase 6  — free key from https://finnhub.io
FINNHUB_API_KEY=

# Phase 15 — from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Phase 20 — from https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set to your deployed API URL in production; localhost default for local dev.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Port overrides (optional — change these if defaults conflict with other local services)
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# API_PORT=8000
# FRONTEND_PORT=3000
